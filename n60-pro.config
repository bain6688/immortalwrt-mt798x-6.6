# 目标架构
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7986=y
CONFIG_TARGET_mediatek_mt7986_DEVICE_netcore_n60-pro=y

# 强制开启 Firewall4 (nftables)
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-offload=y
# 禁用旧版 iptables 相关组件以减少冲突
CONFIG_PACKAGE_firewall=n
CONFIG_PACKAGE_iptables=n

# 界面与主题
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 核心插件 (仅保留你想要的)
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-turboacc-mtk=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# 禁用组播与科学插件 (显式禁用以防 feeds 自动勾选)
CONFIG_PACKAGE_luci-app-omcproxy=n
CONFIG_PACKAGE_luci-app-msd_lite=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-vssr=n

# 解决 mtk_eth_soc.c 宏定义缺失报错
CONFIG_EXTRA_CFLAGS="-DHIT_BIND_FORCE_TO_CPU=0x3 -DMTK_FE_START_RESET=0x10 -DMTK_FE_RESET_DONE=0x11 -DMTK_FE_RESET_NAT_DONE=0x12 -DMTK_WIFI_CHIP_ONLINE=0x13 -DMTK_WIFI_CHIP_OFFLINE=0x14 -DMTK_WIFI_RESET_DONE=0x15"
