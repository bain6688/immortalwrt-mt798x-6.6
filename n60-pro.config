# ==============================
# 目标机型 (237大佬仓库对应的 Target)
# ==============================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7986=y
CONFIG_TARGET_mediatek_mt7986_DEVICE_netcore_n60-pro=y

# ==============================
# Argon 主题
# ==============================
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# 删掉默认的 bootstrap
CONFIG_PACKAGE_luci-theme-bootstrap=n

# ==============================
# 核心功能 (你想要的)
# ==============================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
# 终端工具
CONFIG_PACKAGE_luci-app-ttyd=y

# ==============================
# 硬件加速 (确保 HNAT 开启)
# ==============================
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y

# ==============================
# 存储与系统
# ==============================
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=y

# ==============================
# 精简项 (你不要的)
# ==============================
# 删除组播代理
CONFIG_PACKAGE_luci-app-omcproxy=n
# 删除科学插件的默认组件 (如果仓库默认带了)
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
